# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git.

# The Gmail (or other SMTP) account NextGen Developer sends FROM
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your16digitapppassword

# Where contact-form messages should be delivered TO
CONTACT_EMAIL=hello@nextgendeveloper.com

# Port the server runs on (optional)
PORT=3000
